#!/usr/bin/env bash
#
# Creates a C++ source file with the boilerplate needed to have doctest
# test cases living in the same file as the production code.
#
# Usage: doctest-init <file.cpp>
#
# If the file already exists and is non-empty, asks before overwriting it.

set -Eeuo pipefail

readonly USAGE="Usage: ${0##*/} <file.cpp>"

main() {
  local -r file="${1:?$USAGE}"
  local -r dir="$(dirname -- "$file")"

  [[ -d "$dir" ]] || die "Directory does not exist: $dir"

  if [[ -s "$file" ]] && ! confirm "'$file' is not empty. Overwrite it?"; then
    die "Aborted."
  fi

  print_boilerplate > "$file"
  printf "Created '%s'\n" "$file"
}

die() {
  printf 'ERROR: %s\n' "$1" >&2
  exit 1
}

# Asks a yes/no question. Returns 0 only for an explicit "y" or "yes".
confirm() {
  local -r question="$1"
  local answer

  read -r -p "$question [y/N] " answer || answer=""
  [[ "${answer,,}" =~ ^y(es)?$ ]]
}

print_boilerplate() {
  cat << 'EOF'
#define DOCTEST_CONFIG_IMPLEMENT
#include <doctest/doctest.h>

int main(int argc, char **argv) {
  // -------------------------------------------
  // doctest boilerplate
  // -------------------------------------------
  doctest::Context ctx;
  ctx.applyCommandLine(argc, argv);
  int result = ctx.run();
  if (result != 0 || ctx.shouldExit()) {
    return result;
  }
  // -------------------------------------------

  // production code goes here
}

// -------------------------------------------
// test code
// -------------------------------------------
TEST_CASE("replace me with a real test") {
  CHECK(1 + 1 == 3);
}
EOF
}

main "$@"
